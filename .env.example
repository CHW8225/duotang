ADMIN_USERNAME=replace_with_admin_username
# Format: scrypt$N$r$p$salt$derived_key_hex (escape each $ in .env files)
ADMIN_PASSWORD_HASH=scrypt\$16384\$8\$1\$replace_with_random_salt\$replace_with_derived_key_hex
SESSION_SECRET=replace_with_a_long_random_session_secret
# Local tests and development may omit DATABASE_URL and continue using SQLite.
# Tencent Cloud PostgreSQL production connection string. Never commit real credentials.
DATABASE_URL=postgresql://app_user:replace_with_password@private-postgres-host:5432/polysaccharide
POSTGRES_SSL=disable
POSTGRES_POOL_MAX=10
# SQLite fallback and optional source for migrate:seed:postgres --source sqlite.
DATABASE_PATH=/absolute/path/to/persistent-volume/polysaccharide.sqlite3

# Public HTTPS origin used in verification and password-reset links.
APP_BASE_URL=https://database.example.cn
# "development" keeps test mail in process memory only; production must use Tencent SES.
AUTH_EMAIL_MODE=development
TENCENTCLOUD_SECRET_ID=replace_locally
TENCENTCLOUD_SECRET_KEY=replace_locally
TENCENT_SES_REGION=ap-guangzhou
TENCENT_SES_FROM_EMAIL=database@example.cn
TENCENT_SES_TEMPLATE_ID=replace_with_verified_template_id

# Random secret shared only by Nginx and the Next.js process. Nginx must overwrite,
# not append, the matching request header before proxying.
TRUSTED_PROXY_HEADER_SECRET=replace_with_a_long_random_proxy_secret
